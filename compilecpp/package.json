{
  "name": "compilecpp",
  "displayName": "compilecpp",
  "description": "Compile and run C++ files from VS Code",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.125.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onCommand:compilecpp.helloWorld"
  ],
  "main": "./out/extension.js",
  "contributes": {
  "commands": [
    {
      "command": "compilecpp.runCurrentFile",
      "title": "sTerminal: Compile and Run"
    },
    {
      "command": "compilecpp.stopExecution",
      "title": "sTerminal: Stop Execution"
    }
  ],
  "keybindings": [
    {
      "command": "compilecpp.runCurrentFile",
      "key": "f5",
      "when": "editorTextFocus && resourceLangId == cpp"
    },
    {
      "command": "compilecpp.stopExecution",
      "key": "shift+f5",
      "when": "editorTextFocus && resourceLangId == cpp"
    }
  ]
},
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/vscode": "^1.125.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "24.x",
    "typescript-eslint": "^8.61.1",
    "eslint": "^10.5.0",
    "typescript": "^6.0.3",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.0.0"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6"
  }
}
